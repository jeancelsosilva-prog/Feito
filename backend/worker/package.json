{
  "name": "feito-app-worker",
  "version": "1.0.0",
  "private": true,
  "description": "Backend serverless do app Feito? (Cloudflare Worker + D1 + Web Push).",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "d1:migrate:local": "wrangler d1 migrations apply feito-app-db --local",
    "d1:migrate:remote": "wrangler d1 migrations apply feito-app-db --remote",
    "vapid:generate": "node scripts/generate-vapid-keys.mjs"
  },
  "devDependencies": {
    "wrangler": "^3.90.0"
  }
}
